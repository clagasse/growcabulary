# Supabase Configuration (Required for Cloud Sync & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (Used by scripts/generate-deck.js and /curator for Curator Staging)
GEMINI_API_KEY=your-gemini-api-key

# Curator Studio Admin Email (Comma-separated list of emails allowed to access /curator in production)
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email@example.com
